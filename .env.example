# Copier vers .env.local puis compléter. Ne jamais committer .env.local.

# Supabase — `npx supabase status` affiche les valeurs locales
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# URL publique de l'app (callbacks d'authentification)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# GitHub (facultatif, serveur uniquement) — activité des repos (commits, PR, CI).
# Sans jeton : dépôts publics seulement, 60 requêtes/h. Avec un jeton « fine-grained »
# en lecture seule (Contents, Pull requests, Actions, Issues, Metadata : Read-only) :
# dépôts privés et 5 000 requêtes/h. https://github.com/settings/personal-access-tokens
GITHUB_TOKEN=
